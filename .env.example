# Copy this file to `.env` and adjust as needed.
# Restart the server after changing anything here.

# Secret used to sign login tokens. Change this for a real deployment.
JWT_SECRET=change_me_to_a_long_random_string

# Port the server listens on -> http://localhost:3000
PORT=3000

# Master ON/OFF switch for advertisements.
#   true  -> an ad from the ads/ folder plays before each video
#   false -> no ad, no countdown, no Skip Ad button; video starts immediately
ADS_ENABLED=true

# Seconds before "Skip Ad" becomes clickable (0 = skip immediately).
AD_SKIP_SECONDS=5
